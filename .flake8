[flake8]
# 设置最大行长度
max-line-length = 180

# 忽略特定的错误和警告
# ignore = E501

# 只检查特定的文件类型
# 追加忽略的错误
# extend-ignore = E501, 

# 排除特定的目录或文件
exclude = .venv, .idea, .vscode, demo, resource, dev_test, lib
# 构建缓存、第三方依赖和生成产物；业务源码和 tests 仍正常检查。
extend-exclude = .ppt_build, .codex-finalizer, .superpowers, node_modules, output

# 添加额外的配置（比如启用复杂度检查）
max-complexity = 20
